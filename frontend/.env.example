# Frontend runtime configuration (Vite). Copy to `.env` and adjust as needed.
# Both variables are optional — the app falls back to sensible defaults.

# Port the Vite dev/preview server binds to. Default: 4000
VITE_PORT=4000

# Base URL of the backend API, including the /api prefix. Default: http://localhost:9000/api
VITE_API_BASE=http://localhost:9000/api
