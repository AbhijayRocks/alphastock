# Backend runtime configuration. Copy to `.env` (in the backend/ folder) and
# adjust as needed. All variables are optional — the API falls back to defaults.

# ── Server bind ──────────────────────────────────────────────────────────────
# Host interface to bind. Default: 0.0.0.0 (all interfaces)
HOST=0.0.0.0
# Port the API listens on. Default: 9000  (Render injects this automatically)
PORT=9000
# Auto-reload on code changes — set to true only for local development.
RELOAD=false

# ── Integrations (see SETUP.md) ──────────────────────────────────────────────
# NEWS_API_KEY=get_free_key_from_newsapi.org
# HF_TOKEN=get_free_token_from_huggingface.co/settings/tokens
# HF_REPO_ID=your-hf-username/alpha-stock-models

# ── Auth / database (optional) ───────────────────────────────────────────────
# Stable secret so JWTs survive restarts (auto-generated in dev if unset).
# ALPHASTOCK_SECRET=<a-long-random-string>
# Use Postgres instead of the default zero-config SQLite file.
# DATABASE_URL=postgresql://user:pass@host:5432/alphastock
